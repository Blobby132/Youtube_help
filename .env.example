# Copy this file to .env (npm run setup does it for you) and fill in the values.

# Free key from https://www.pexels.com/api/ - used for stock video search.
PEXELS_API_KEY=

# Where the AI voice (Kokoro) runs:
#   cpu       - default, works everywhere
#   directml  - GPU on Windows through DirectML (AMD Radeon, Intel Arc, NVIDIA).
#               Run `npm run setup` again after changing this; it swaps the ONNX Runtime package.
#               If the GPU path fails, the app falls back to CPU and says so in the log.
TTS_DEVICE=cpu

# Whisper model for captions (always runs on the CPU). small.en is the default balance of
# speed and accuracy; base.en is faster, medium.en more accurate. Run `npm run setup` after
# changing it to download the new model (or it downloads on the first caption run).
WHISPER_MODEL=small.en

# Optional overrides
# BACKEND_PORT=8765
# FRONTEND_PORT=5173
# PROJECTS_DIR=projects
# DATA_DIR=data              (app-wide data such as the pronunciation list)
# LIBRARY_DIR=library        (the media library shared by all projects)
# MODELS_DIR=models
